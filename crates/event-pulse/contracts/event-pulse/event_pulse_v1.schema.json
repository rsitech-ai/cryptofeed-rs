{
  "$defs": {
    "Asset": {
      "enum": [
        "BTC",
        "ETH",
        "SOL",
        "BNB",
        "HYPE"
      ],
      "title": "Asset",
      "type": "string"
    },
    "AttributionState": {
      "enum": [
        "UNKNOWN",
        "CANDIDATE",
        "CONFIRMED",
        "DISPUTED"
      ],
      "title": "AttributionState",
      "type": "string"
    },
    "CausalTime": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "clock_quality": {
          "$ref": "#/$defs/ClockQualityState"
        },
        "decision_time": {
          "format": "date-time",
          "title": "Decision Time",
          "type": "string"
        },
        "normalized_at": {
          "format": "date-time",
          "title": "Normalized At",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "source_event_time": {
          "format": "date-time",
          "title": "Source Event Time",
          "type": "string"
        }
      },
      "required": [
        "source_event_time",
        "received_at",
        "normalized_at",
        "available_at",
        "decision_time",
        "clock_quality"
      ],
      "title": "CausalTime",
      "type": "object"
    },
    "ClockQualityState": {
      "additionalProperties": false,
      "properties": {
        "clock_state": {
          "$ref": "#/$defs/ClockState",
          "enum": [
            "synchronized",
            "degraded"
          ]
        },
        "freshness_limit_ms": {
          "exclusiveMinimum": 0,
          "title": "Freshness Limit Ms",
          "type": "integer"
        },
        "observed_skew_ms": {
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Observed Skew Ms",
          "type": "string"
        },
        "quality_state": {
          "$ref": "#/$defs/QualityState",
          "enum": [
            "validated",
            "degraded"
          ]
        },
        "reason_code": {
          "minLength": 1,
          "pattern": "^[\\s\\S]*\\S[\\s\\S]*$",
          "title": "Reason Code",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "pattern": "^[\\s\\S]*\\S[\\s\\S]*$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "clock_state",
        "observed_skew_ms",
        "freshness_limit_ms",
        "quality_state",
        "reason_code"
      ],
      "title": "ClockQualityState",
      "type": "object"
    },
    "ClockState": {
      "enum": [
        "synchronized",
        "degraded",
        "unsynchronized",
        "unknown"
      ],
      "title": "ClockState",
      "type": "string"
    },
    "ContextEvidence": {
      "additionalProperties": false,
      "properties": {
        "attribution_state": {
          "$ref": "#/$defs/AttributionState"
        },
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "evidence_id": {
          "pattern": "^event_evidence_[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_type": {
          "$ref": "#/$defs/ContextEvidenceType"
        },
        "first_seen_at": {
          "format": "date-time",
          "title": "First Seen At",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Source Id",
          "type": "string"
        },
        "source_payload_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Payload Hash",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "evidence_type",
        "source_id",
        "source_payload_hash",
        "first_seen_at",
        "available_at",
        "attribution_state"
      ],
      "title": "ContextEvidence",
      "type": "object"
    },
    "ContextEvidenceType": {
      "enum": [
        "OFFICIAL_RELEASE",
        "NEWS",
        "WALLET_FLOW",
        "EXCHANGE_FLOW",
        "ONCHAIN",
        "MARKET_CONTEXT"
      ],
      "title": "ContextEvidenceType",
      "type": "string"
    },
    "Direction": {
      "enum": [
        "UP",
        "DOWN",
        "MIXED",
        "UNKNOWN"
      ],
      "title": "Direction",
      "type": "string"
    },
    "EventPhase": {
      "enum": [
        "NORMAL",
        "BUILDUP",
        "IGNITION",
        "CASCADE",
        "EXHAUSTION",
        "AFTERMATH",
        "INVALID"
      ],
      "title": "EventPhase",
      "type": "string"
    },
    "EventPulseComposite": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "revision": {
                "const": 1
              }
            },
            "required": [
              "revision"
            ]
          },
          "then": {
            "properties": {
              "predecessor_content_hash": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "revision": {
                "minimum": 2
              }
            },
            "required": [
              "revision"
            ]
          },
          "then": {
            "properties": {
              "predecessor_content_hash": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              }
            },
            "required": [
              "predecessor_content_hash"
            ]
          }
        }
      ],
      "properties": {
        "catalyst_confidence": {
          "anyOf": [
            {
              "pattern": "^(?:0(?:\\.[0-9]{1,8})?|1(?:\\.0{1,8})?)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Catalyst Confidence"
        },
        "causal_time": {
          "$ref": "#/$defs/CausalTime"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "context_content_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Context Content Hash"
        },
        "context_lineage_id": {
          "anyOf": [
            {
              "pattern": "^lineage_[A-Za-z0-9][A-Za-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Context Lineage Id"
        },
        "contract_id": {
          "pattern": "^event_pulse_composite_[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Contract Id",
          "type": "string"
        },
        "contract_type": {
          "const": "composite",
          "title": "Contract Type",
          "type": "string"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "event_cluster_id": {
          "pattern": "^event_cluster_[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Event Cluster Id",
          "type": "string"
        },
        "event_type": {
          "$ref": "#/$defs/EventType"
        },
        "evidence_state": {
          "$ref": "#/$defs/EvidenceState"
        },
        "execution_authority": {
          "const": false,
          "default": false,
          "title": "Execution Authority",
          "type": "boolean"
        },
        "expected_half_life_ms": {
          "maximum": 86400000,
          "minimum": 1,
          "title": "Expected Half Life Ms",
          "type": "integer"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "lineage_id": {
          "pattern": "^lineage_[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Lineage Id",
          "type": "string"
        },
        "mechanical_confidence": {
          "pattern": "^(?:0(?:\\.[0-9]{1,8})?|1(?:\\.0{1,8})?)$",
          "title": "Mechanical Confidence",
          "type": "string"
        },
        "mechanical_intensity": {
          "pattern": "^(?:0(?:\\.[0-9]{1,8})?|1(?:\\.0{1,8})?)$",
          "title": "Mechanical Intensity",
          "type": "string"
        },
        "mechanics_content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Mechanics Content Hash",
          "type": "string"
        },
        "mechanics_lineage_id": {
          "pattern": "^lineage_[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Mechanics Lineage Id",
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/EventPhase"
        },
        "predecessor_content_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predecessor Content Hash"
        },
        "producer": {
          "const": "hummingbot_api_event_pulse_composite",
          "title": "Producer",
          "type": "string"
        },
        "protective_exit_control": {
          "const": false,
          "default": false,
          "title": "Protective Exit Control",
          "type": "boolean"
        },
        "quality_flags": {
          "items": {
            "$ref": "#/$defs/QualityFlag"
          },
          "title": "Quality Flags",
          "type": "array"
        },
        "reversal_risk": {
          "pattern": "^(?:0(?:\\.[0-9]{1,8})?|1(?:\\.0{1,8})?)$",
          "title": "Reversal Risk",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "risk_authority": {
          "const": false,
          "default": false,
          "title": "Risk Authority",
          "type": "boolean"
        },
        "schema_version": {
          "const": "event-pulse/1.0",
          "default": "event-pulse/1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/EventScope"
        },
        "source_qualification": {
          "$ref": "#/$defs/SourceQualification"
        }
      },
      "required": [
        "schema_version",
        "contract_id",
        "lineage_id",
        "revision",
        "predecessor_content_hash",
        "content_hash",
        "causal_time",
        "producer",
        "event_cluster_id",
        "scope",
        "contract_type",
        "mechanics_content_hash",
        "context_content_hash",
        "mechanics_lineage_id",
        "context_lineage_id",
        "phase",
        "event_type",
        "direction",
        "mechanical_intensity",
        "mechanical_confidence",
        "catalyst_confidence",
        "reversal_risk",
        "evidence_state",
        "source_qualification",
        "quality_flags",
        "expected_half_life_ms",
        "expires_at",
        "execution_authority",
        "risk_authority",
        "protective_exit_control"
      ],
      "title": "EventPulseComposite",
      "type": "object"
    },
    "EventPulseContext": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
