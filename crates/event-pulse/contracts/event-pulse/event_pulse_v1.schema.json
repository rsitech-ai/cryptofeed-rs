        "reason_code": {
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Reason Code",
          "type": "string"
        },
        "unit": {
          "$ref": "#/$defs/FeatureUnit"
        },
        "value": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]{0,17})(?:\\.[0-9]{1,8})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "value",
        "unit",
        "horizon_ms",
        "quality_state",
        "reason_code"
      ],
      "title": "FeatureObservation",
      "type": "object"
    },
    "FeatureUnit": {
      "enum": [
        "LOG_RETURN",
        "RATIO",
        "BASE_PER_SECOND",
        "BPS",
        "USDC",
        "CONTRACTS"
      ],
      "title": "FeatureUnit",
      "type": "string"
    },
    "InstrumentIdentity": {
      "additionalProperties": false,
      "properties": {
        "base_asset": {
          "$ref": "#/$defs/Asset"
        },
        "market_type": {
          "$ref": "#/$defs/MarketType"
        },
        "quote_asset": {
          "$ref": "#/$defs/QuoteAsset"
        },
        "venue": {
          "$ref": "#/$defs/Venue"
        },
        "venue_symbol": {
          "minLength": 1,
          "pattern": "^[A-Z0-9][A-Z0-9_-]*$",
          "title": "Venue Symbol",
          "type": "string"
        }
      },
      "required": [
        "base_asset",
        "quote_asset",
        "market_type",
        "venue",
        "venue_symbol"
      ],
      "title": "InstrumentIdentity",
      "type": "object"
    },
    "MarketType": {
      "enum": [
        "SPOT",
        "PERPETUAL"
      ],
      "title": "MarketType",
      "type": "string"
    },
    "QualityFlag": {
      "enum": [
        "SEQUENCE_GAP",
        "BOOK_RESYNCING",
        "CLOCK_UNCERTAIN",
        "SOURCE_STALE",
        "OI_STALE",
        "MARK_MISSING",
        "CROSS_VENUE_DIVERGENCE",
        "QUEUE_DROP",
        "RECONNECT_WARMUP",
        "INSUFFICIENT_COVERAGE",
        "LATE_CONTEXT"
      ],
      "title": "QualityFlag",
      "type": "string"
    },
    "QualityState": {
      "enum": [
        "validated",
        "degraded",
        "invalid",
        "unavailable"
      ],
      "title": "QualityState",
      "type": "string"
    },
    "QuoteAsset": {
      "enum": [
        "USD",
        "USDC",
        "USDT"
      ],
      "title": "QuoteAsset",
      "type": "string"
    },
    "ScopeKind": {
      "enum": [
        "GLOBAL_CRYPTO",
        "ASSET",
        "VENUE",
        "PAIR"
      ],
      "title": "ScopeKind",
      "type": "string"
    },
    "SourceCursor": {
      "additionalProperties": false,
      "properties": {
        "available_at": {
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "connection_epoch": {
          "maxLength": 70,
          "minLength": 7,
          "pattern": "^epoch_[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Connection Epoch",
          "type": "string"
        },
        "sequence_end": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Sequence End",
          "type": "integer"
        },
        "sequence_start": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Sequence Start",
          "type": "integer"
        },
        "source_id": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Source Id",
          "type": "string"
        },
        "source_payload_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Payload Hash",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "connection_epoch",
        "sequence_start",
        "sequence_end",
        "available_at",
        "source_payload_hash"
      ],
      "title": "SourceCursor",
      "type": "object"
    },
    "SourceQualification": {
      "enum": [
        "UNVERIFIED"
      ],
      "title": "SourceQualification",
      "type": "string"
    },
    "Venue": {
      "enum": [
        "BINANCE",
        "HYPERLIQUID"
      ],
      "title": "Venue",
      "type": "string"
    }
  },
  "discriminator": {
    "mapping": {
      "composite": "#/$defs/EventPulseComposite",
      "context": "#/$defs/EventPulseContext",
      "mechanics": "#/$defs/EventPulseMechanics"
    },
    "propertyName": "contract_type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/EventPulseMechanics"
    },
    {
      "$ref": "#/$defs/EventPulseContext"
    },
    {
      "$ref": "#/$defs/EventPulseComposite"
    }
  ]
}
