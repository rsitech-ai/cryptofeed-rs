        "catalyst_confidence": {
          "pattern": "^(?:0(?:\\.[0-9]{1,8})?|1(?:\\.0{1,8})?)$",
          "title": "Catalyst Confidence",
          "type": "string"
        },
        "catalyst_type": {
          "$ref": "#/$defs/EventType"
        },
        "causal_time": {
          "$ref": "#/$defs/CausalTime"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "contract_id": {
          "pattern": "^event_pulse_context_[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Contract Id",
          "type": "string"
        },
        "contract_type": {
          "const": "context",
          "title": "Contract Type",
          "type": "string"
        },
        "event_cluster_id": {
          "pattern": "^event_cluster_[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Event Cluster Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ContextEvidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "lineage_id": {
          "pattern": "^lineage_[A-Za-z0-9][A-Za-z0-9_-]*$",
          "title": "Lineage Id",
          "type": "string"
        },
        "predecessor_content_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predecessor Content Hash"
        },
        "producer": {
          "const": "hummingbot_api_event_pulse_context",
          "title": "Producer",
          "type": "string"
        },
        "quality_flags": {
          "items": {
            "$ref": "#/$defs/QualityFlag"
          },
          "title": "Quality Flags",
          "type": "array"
        },
        "quality_state": {
          "$ref": "#/$defs/EventQualityState"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "event-pulse/1.0",
          "default": "event-pulse/1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/EventScope"
        },
        "source_qualification": {
          "$ref": "#/$defs/SourceQualification"
        }
      },
      "required": [
        "schema_version",
        "contract_id",
        "lineage_id",
        "revision",
        "predecessor_content_hash",
        "content_hash",
        "causal_time",
        "producer",
        "event_cluster_id",
        "scope",
        "contract_type",
        "attribution_state",
        "catalyst_type",
        "catalyst_confidence",
        "quality_state",
        "source_qualification",
        "quality_flags",
        "evidence"
      ],
      "title": "EventPulseContext",
      "type": "object"
    },
