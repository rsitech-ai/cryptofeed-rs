{"database":{"advisory-count":1338,"last-commit":"999ec89d5d3f10f20be14750ec8c2d8b44e0ac9b","last-updated":"2026-10-17T17:23:59+02:00"},"lockfile":{"dependency-count":300},"settings":{"target_arch":[],"target_os":[],"severity":null,"ignore":[],"informational_warnings":["unmaintained","unsound","notice"]},"vulnerabilities":{"found":true,"count":1,"list":[{"advisory":{"id":"RUSTSEC-2026-0009","package":"time","title":"Denial of Service via Stack Exhaustion","description":"## Impact\n\nWhen user-provided input is provided to any type that parses with the RFC 2822 format, a denial of\nservice attack via stack exhaustion is possible. The attack relies on formally deprecated and\nrarely-used features that are part of the RFC 2822 format used in a malicious manner. Ordinary,\nnon-malicious input will never encounter this scenario.\n\n## Patches\n\nA limit to the depth of recursion was added in v0.3.47. From this version, an error will be returned\nrather than exhausting the stack.\n\n## Workarounds\n\nLimiting the length of user input is the simplest way to avoid stack exhaustion, as the amount of\nthe stack consumed would be at most a factor of the length of the input.","date":"2026-02-05","aliases":["CVE-2026-25727","GHSA-r6v5-fh4h-64xc"],"related":[],"collection":"crates","categories":["denial-of-service"],"keywords":["stack","exhaustion"],"cvss":"CVSS:4.0/AV:N/AC:H/AT:N/PR:L/UI:A/VC:N/VI:N/VA:H/SC:N/SI:N/SA:H","informational":null,"references":[],"source":null,"url":"https://github.com/time-rs/time/blob/main/CHANGELOG.md#0347-2026-02-05","withdrawn":null,"license":"CC0-1.0","expect-deleted":false},"versions":{"patched":[">=0.3.47"],"unaffected":["<0.3.6"]},"affected":{"arch":[],"os":[],"functions":{"time::Date::parse":[">=0.3.6, <0.3.47"],"time::OffsetDateTime::parse":[">=0.3.6, <0.3.47"],"time::PrimitiveDateTime::parse":[">=0.3.6, <0.3.47"],"time::Time::parse":[">=0.3.6, <0.3.47"],"time::UtcDateTime::parse":[">=0.3.38, <0.3.47"],"time::UtcOffset::parse":[">=0.3.6, <0.3.47"],"time::parsing::Parsed::parse_item":[">=0.3.6, <0.3.47"]}},"package":{"name":"time","version":"0.3.41","source":"registry+https://github.com/rust-lang/crates.io-index","checksum":"8a7619e19bc266e0f9c5e6686659d394bc57973859340060a69221e57dbc0c40","dependencies":[{"name":"deranged","version":"0.4.0","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"itoa","version":"1.0.18","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"num-conv","version":"0.1.0","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"powerfmt","version":"0.2.0","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"serde","version":"1.0.229","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"time-core","version":"0.1.4","source":"registry+https://github.com/rust-lang/crates.io-index"},{"name":"time-macros","version":"0.2.22","source":"registry+https://github.com/rust-lang/crates.io-index"}],"replace":null}}]},"warnings":{}}
