{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsitech.ai/cryptofeed-rs/schema/dataset-manifest-v1",
  "title": "Proposed dataset manifest v1; not implemented publication",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "revision_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_manifest_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "requested": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instruments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "utc_interval": {
          "$ref": "#/$defs/interval"
        }
      },
      "required": [
        "instruments",
        "utc_interval"
      ]
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instruments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "event_time_bounds_ns": {
          "type": "array",
          "prefixItems": [
            {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^-?(0|[1-9][0-9]*)$"
            },
            {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^-?(0|[1-9][0-9]*)$"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "receipt_time_bounds_ns": {
          "type": "array",
          "prefixItems": [
            {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^-?(0|[1-9][0-9]*)$"
            },
            {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^-?(0|[1-9][0-9]*)$"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "availability_time_bounds_ns": {
          "type": "array",
          "prefixItems": [
            {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^-?(0|[1-9][0-9]*)$"
            },
            {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^-?(0|[1-9][0-9]*)$"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "instruments",
        "event_time_bounds_ns",
        "receipt_time_bounds_ns",
        "availability_time_bounds_ns"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "build": {
          "$ref": "#/$defs/object_ref"
        },
        "configuration": {
          "$ref": "#/$defs/object_ref"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lockfile": {
          "$ref": "#/$defs/object_ref"
        },
        "decoder": {
          "$ref": "#/$defs/object_ref"
        },
        "schema": {
          "$ref": "#/$defs/object_ref"
        },
        "instrument_metadata": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/object_ref"
          }
        },
        "validation_policy": {
          "$ref": "#/$defs/object_ref"
        },
        "acquisitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/acquisition"
          }
        }
      },
      "required": [
        "source_commit",
        "build",
        "configuration",
        "features",
        "lockfile",
        "decoder",
        "schema",
        "instrument_metadata",
        "validation_policy",
        "acquisitions"
      ]
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/data_object"
      }
    },
    "accounting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "received_messages": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "trade_bearing_messages": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "native_rows": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "canonical_rows": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "controls": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "intentional_exclusions": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "rejected_rows": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "quarantined_rows": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "duplicate_sightings": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "conflicting_duplicates": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "writer_accepted_rows": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "synced_rows": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "manifest_committed_rows": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "received_messages",
        "trade_bearing_messages",
        "native_rows",
        "canonical_rows",
        "controls",
        "intentional_exclusions",
        "rejected_rows",
        "quarantined_rows",
        "duplicate_sightings",
        "conflicting_duplicates",
        "writer_accepted_rows",
        "synced_rows",
        "manifest_committed_rows"
      ]
    },
    "aggregate_constituents": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^-?(0|[1-9][0-9]*)$"
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage"
      }
    },
    "reconciliation_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/object_ref"
      }
    },
    "watermark_checkpoint": {
      "$ref": "#/$defs/object_ref"
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "qualified",
            "validated-not-qualified",
            "quarantined",
            "rejected"
          ]
        },
        "supported_profiles": {
          "type": "array",
          "items": {
            "enum": [
              "descriptive",
              "execution-count",
              "signed-execution-flow",
              "confirmed-candle",
              "observed-availability-replay"
            ]
          }
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/object_ref"
          }
        }
      },
      "required": [
        "decision",
        "supported_profiles",
        "reason_codes",
        "evidence"
      ]
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "staged",
            "published"
          ]
        },
        "backend": {
          "enum": [
            "local-filesystem",
            "object-store"
          ]
        },
        "commit_record": {
          "$ref": "#/$defs/object_ref"
        },
        "published_at_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "status",
        "backend",
        "commit_record",
        "published_at_utc"
      ]
    }
  },
  "required": [
    "schema_version",
    "dataset_id",
    "revision_id",
    "parent_manifest_sha256",
    "requested",
    "observed",
    "provenance",
    "objects",
    "accounting",
    "aggregate_constituents",
    "coverage",
    "reconciliation_evidence",
    "watermark_checkpoint",
    "quality",
    "publication"
  ],
  "$defs": {
    "object_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ]
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_utc": {
          "type": "string",
          "format": "date-time"
        },
        "end_utc": {
          "type": "string",
          "format": "date-time"
        },
        "boundary": {
          "const": "[start,end)"
        }
      },
      "required": [
        "start_utc",
        "end_utc",
        "boundary"
      ]
    },
    "data_object": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "object": {
          "$ref": "#/$defs/object_ref"
        },
        "kind": {
          "enum": [
            "mfr1",
            "historical-original",
            "canonical-parquet",
            "sidecar"
          ]
        },
        "rows": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "event_time_bounds_ns": {
          "type": "array",
          "prefixItems": [
            {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^-?(0|[1-9][0-9]*)$"
            },
            {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^-?(0|[1-9][0-9]*)$"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "semantic_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "raw_parents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/object_ref"
          }
        },
        "metadata_parents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/object_ref"
          }
        }
      },
      "required": [
        "object",
        "kind",
        "rows",
        "event_time_bounds_ns",
        "semantic_sha256",
        "raw_parents",
        "metadata_parents"
      ]
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "live",
            "snapshot",
            "backfill",
            "archive"
          ]
        },
        "venue": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "api_product": {
          "type": "string",
          "minLength": 1
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "capture_or_retrieval_utc": {
          "type": "string",
          "format": "date-time"
        },
        "context_id": {
          "type": "string",
          "minLength": 1
        },
        "cursor_checkpoint": {
          "$ref": "#/$defs/object_ref"
        },
        "live_backfill_boundaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interval"
          }
        }
      },
      "required": [
        "mode",
        "venue",
        "region",
        "api_product",
        "endpoint",
        "channel",
        "capture_or_retrieval_utc",
        "context_id",
        "cursor_checkpoint",
        "live_backfill_boundaries"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stream_identity": {
          "type": "string",
          "minLength": 1
        },
        "interval": {
          "$ref": "#/$defs/interval"
        },
        "state": {
          "enum": [
            "verified-continuity",
            "recovered",
            "suspected-gap",
            "confirmed-gap",
            "unknown-continuity",
            "verified-no-trades"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/object_ref"
          }
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "stream_identity",
        "interval",
        "state",
        "evidence",
        "reason_codes"
      ]
    }
  }
}
