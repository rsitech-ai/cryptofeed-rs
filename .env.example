# Local secrets (never commit). Copy to `.env` and fill — `.env` is gitignored.
#
# Private live smoke (library) — no order placement:
#   set -a && source .env && set +a
#   cargo test -p marketfeed-private --features live --test live_ignored -- --ignored --nocapture
#
# Laptop private canary (skips venues whose keys are missing; archives evidence):
#   ./scripts/laptop_private_canary.sh
#   INCLUDE_EXTENDED=1 INCLUDE_REAUTH=1 ./scripts/laptop_private_canary.sh
#   DRY_RUN=1 ./scripts/laptop_private_canary.sh
#
# Optional duration overrides (seconds):
#   PRIVATE_LIVE_SECS=5
#   PRIVATE_LIVE_EXTENDED_SECS=30
#
# Daemon private sessions currently fail closed until a bounded durable account
# sink, readiness/liveness tracking, and reconnect supervision are implemented.
# These credentials are for explicit marketfeed-private library callers/tests.
#
# Binance private streaming is blocked pending authenticated WebSocket API migration.

# OKX private WS login (HMAC + passphrase).
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# Bybit private WS auth (HMAC).
BYBIT_API_KEY=
BYBIT_API_SECRET=
